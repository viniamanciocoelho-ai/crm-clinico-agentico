{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "types": ["bun"],
    "paths": {
      "@cav-crm/*": ["../*/src"]
    }
  },
  "include": ["src/**/*", "../db/sqlite-bindings.d.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
