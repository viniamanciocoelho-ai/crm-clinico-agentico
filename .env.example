# Database variables
DATABASE_URL=file:./dev.db
TURSO_CONNECTION_URL=

# API
PORT=3001
JWT_SECRET=troque-por-um-segredo-unico
PASSWORD_SALT=troque-por-um-salt-unico

# Env
NODE_ENV=development

# Modo demonstração (dados sintéticos, senha demo exibida no login e troca
# direta de perfil). Vale para a API e para o bundle do front, que a lê em
# tempo de build. Deixe false ou remova em qualquer ambiente real.
DEMO_MODE=false
